{
  "name": "native-window-monorepo",
  "private": true,
  "scripts": {
    "changeset": "changeset",
    "build": "vp run --filter \"./packages/*\" build",
    "build:ts": "vp run --filter \"./packages/*\" build:ts",
    "format": "vp fmt packages samples docs vite.config.ts",
    "lint": "vp lint packages samples docs vite.config.ts",
    "test": "vp test",
    "typecheck": "vp run -r typecheck",
    "dev": "vp run --filter \"./samples/*\" dev",
    "build:native": "pnpm --filter @nativewindow/webview run build",
    "lint:native": "pnpm --filter @nativewindow/webview run lint:native",
    "format:native": "pnpm --filter @nativewindow/webview run format:native",
    "test:native": "node --input-type=module -e \"import('./packages/webview/dist/index.js')\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
