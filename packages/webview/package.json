{
  "name": "@nativewindow/webview",
  "version": "1.0.7",
  "description": "Native OS webview windows for Bun & Node.js (beta)",
  "homepage": "https://nativewindow.fcannizzaro.com",
  "bugs": {
    "url": "https://github.com/nativewindow/webview/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Francesco Saverio Cannizzaro (fcannizzaro)",
    "url": "https://fcannizzaro.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nativewindow/webview"
  },
  "funding": [
    {
      "type": "patreon",
      "url": "https://www.patreon.com/fcannizzaro"
    }
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "napi build --release --platform --no-js && node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('index.d.ts', { force: true });\" && vp build",
    "build:debug": "napi build --platform --no-js && node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('index.d.ts', { force: true });\" && vp build",
    "build:ts": "vp build",
    "version": "napi version",
    "fuzz": "cargo +nightly fuzz list --fuzz-dir fuzz",
    "fuzz:json-escape": "cargo +nightly fuzz run fuzz_json_escape --fuzz-dir fuzz",
    "fuzz:extract-origin": "cargo +nightly fuzz run fuzz_extract_origin --fuzz-dir fuzz",
    "fuzz:host-matching": "cargo +nightly fuzz run fuzz_host_matching --fuzz-dir fuzz",
    "fuzz:url-scheme": "cargo +nightly fuzz run fuzz_url_scheme --fuzz-dir fuzz",
    "typecheck": "tsc --noEmit",
    "lint:native": "cargo clippy --locked --all-targets -- -D warnings",
    "format:native": "cargo fmt --all"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.9",
    "@types/node": "^24.19.2",
    "vite": "catalog:",
    "vite-plugin-dts": "^5.1.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^6.0.2"
  },
  "optionalDependencies": {
    "@nativewindow/webview-darwin-arm64": "1.0.7",
    "@nativewindow/webview-darwin-x64": "1.0.7",
    "@nativewindow/webview-linux-arm64-gnu": "1.0.7",
    "@nativewindow/webview-linux-x64-gnu": "1.0.7",
    "@nativewindow/webview-win32-arm64-msvc": "1.0.7",
    "@nativewindow/webview-win32-x64-msvc": "1.0.7"
  },
  "napi": {
    "binaryName": "native-window",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  }
}
